# Netlify site environment (Site settings → Environment variables).
# None of these values appear in any public page or repo file.

# Claude API key for lead triage (required for triage; leads still log without it)
ANTHROPIC_API_KEY=

# Triage model (default: claude-haiku-4-5-20251001 — fast + cheap for classification)
# ANTHROPIC_MODEL=

# Resend API key for operator notifications (required for email notifications)
RESEND_API_KEY=

# Recipient for ALL lead notifications. Recipient-only: never appears in a
# FROM field, page, or template. This site's operator inbox:
OPERATOR_EMAIL=john@pinellasiceco.com

# From identity once a domain is verified in Resend (fallback works unverified)
# NOTIFY_FROM_EMAIL=Pinellas Ice Ops <ops@notifications.pinellasiceco.com>

# Kill switch: set to false to disable triage (submissions still dead-letter to the log)
# OPS_TRIAGE_ENABLED=true
