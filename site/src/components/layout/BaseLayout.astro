---
import Header from './Header.astro';
import Footer from './Footer.astro';
import StickyCallBar from './StickyCallBar.astro';
import { PHONE_TEL, GA4_ID } from '../../config';
import '../../styles/global.css';

interface Props {
  /** COMPLETE title tag — pages own their full title (Tier A titles are verbatim). */
  pageTitle: string;
  metaDescription: string;
  canonicalURL?: string;
  ogImage?: string;
  schemaMarkup?: object | object[];
  noIndex?: boolean;
}

const { pageTitle, metaDescription, canonicalURL, ogImage, schemaMarkup, noIndex = false } = Astro.props;

// Directory build format: served URLs always end in a slash. Canonicals strip
// query parameters by construction (built from pathname only).
const rawCanonical = canonicalURL || new URL(Astro.url.pathname, Astro.site).href;
const canonical = rawCanonical.endsWith('/') ? rawCanonical : `${rawCanonical}/`;
const ogImageFull = new URL(ogImage || '/og-default.png', Astro.site).href;

// LocalBusiness entity — emitted once on every page. NAP must match the
// Google Business Profile exactly. [OPERATOR: confirm] street address +
// hours are omitted until confirmed (service-area business).
const businessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.pinellasiceco.com/#business",
  "name": "Pinellas Ice Co",
  "url": "https://www.pinellasiceco.com/",
  "telephone": PHONE_TEL,
  "email": "service@pinellasiceco.com",
  "image": "https://www.pinellasiceco.com/images/pinellas-ice-co-logo.webp",
  "logo": "https://www.pinellasiceco.com/images/pinellas-ice-co-logo.webp",
  "description": "Commercial ice machine repair, sales, leasing, and cleaning across Tampa Bay — Tampa, St. Petersburg, Clearwater, and Pinellas, Hillsborough, and Pasco counties.",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Clearwater",
    "addressRegion": "FL",
    "addressCountry": "US"
  },
  "areaServed": [
    { "@type": "City", "name": "Tampa" },
    { "@type": "City", "name": "St. Petersburg" },
    { "@type": "City", "name": "Clearwater" },
    { "@type": "City", "name": "Largo" },
    { "@type": "City", "name": "Dunedin" },
    { "@type": "City", "name": "Palm Harbor" },
    { "@type": "AdministrativeArea", "name": "Pinellas County" },
    { "@type": "AdministrativeArea", "name": "Hillsborough County" },
    { "@type": "AdministrativeArea", "name": "Pasco County" }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noIndex ? 'noindex,nofollow' : 'index,follow'} />

  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageFull} />
  <meta property="og:site_name" content="Pinellas Ice Co" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImageFull} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-800.woff2" as="font" type="font/woff2" crossorigin />

  <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
  {schemaMarkup && (
    <script type="application/ld+json" set:html={JSON.stringify(Array.isArray(schemaMarkup) ? schemaMarkup : [schemaMarkup])} />
  )}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <StickyCallBar />

  {GA4_ID && (
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
  )}
  {GA4_ID && (
    <script is:inline define:vars={{ GA4_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', GA4_ID);

      // Phone-side telemetry: every tel: click fires call_click with the
      // page path and the element's location tag (sticky-bar / header /
      // body). Lead forms fire lead_form_submit with the segment field —
      // this is what separates phone demand from form demand per page.
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
        if (a) {
          gtag('event', 'call_click', {
            page_path: location.pathname,
            link_location: a.dataset.loc || (a.closest('header') ? 'header' : a.closest('footer') ? 'footer' : 'body'),
          });
        }
      });
      document.addEventListener('submit', function (e) {
        var f = e.target;
        if (f && f.name === 'lead-capture') {
          var seg = f.querySelector('input[name="segment"]');
          var urg = f.querySelector('[name="urgency"]');
          gtag('event', 'lead_form_submit', {
            page_path: location.pathname,
            segment: seg ? seg.value : 'unknown',
            urgency: urg && urg.value ? urg.value : undefined,
          });
        }
      });
    </script>
  )}
</body>
</html>
