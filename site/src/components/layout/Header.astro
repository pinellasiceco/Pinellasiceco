---
import Icon from '../ui/Icon.astro';
import { PHONE_HREF, PHONE_DISPLAY } from '../../config';
// Phone click-to-call is in the header on EVERY page — the one non-negotiable.
// Desktop shows the response line under the number. Nav order mirrors the
// site-purpose hierarchy: repair first, sales/leasing second, cleaning
// supporting. CSS-only mobile menu (checkbox toggle, zero JS).
// Sales-first ordering per the sales-first expansion directive.
const nav = [
  { href: '/commercial-ice-machine-sales/', label: 'Sales' },
  { href: '/ice-machine-leasing/', label: 'Leasing' },
  { href: '/ice-machine-repair/', label: 'Repair' },
  { href: '/ice-machine-cleaning/', label: 'Cleaning' },
  { href: '/ice-machine-cost-calculator/', label: 'Pricing & Sizing' },
  { href: '/brands/', label: 'Brands' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Pinellas Ice Co — home">
      <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" fill="#6FB4E8" stroke="#16294E" stroke-width="1.7"/>
        <path d="M3.27 6.96L12 12.01l8.73-5.05" stroke="#16294E" stroke-width="1.7"/>
        <path d="M12 22.08V12" stroke="#16294E" stroke-width="1.7"/>
      </svg>
      <span class="brand-text">Pinellas <em>Ice Co</em></span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Open menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Main">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/ice-machine-troubleshooting/" class="nav-help">Get Help</a>
    </nav>

    <div class="header-call">
      <a href={PHONE_HREF} class="btn btn-urgent header-phone" data-loc="header">
        <Icon name="phone" size={18} />
        <span>{PHONE_DISPLAY}</span>
      </a>
      <span class="header-response">Fast callbacks · same-day service when available</span>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 100;
    background: #fff;
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex; align-items: center; gap: var(--space-6);
    height: 64px;
  }
  .brand {
    display: flex; align-items: center; gap: 0.55rem;
    text-decoration: none; flex: none;
  }
  .brand-text {
    font-weight: 800; font-size: 1.15rem; color: var(--navy); letter-spacing: -0.01em;
  }
  .brand-text em { font-style: normal; color: var(--blue-dark); }

  .site-nav { display: flex; gap: var(--space-4); align-items: center; margin-left: auto; }
  .site-nav a {
    text-decoration: none; color: var(--text-2); font-weight: 600; font-size: var(--text-sm);
    padding: 0.35rem 0.2rem;
  }
  .site-nav a:hover { color: var(--navy); }
  .site-nav .nav-help {
    color: var(--blue-dark); border: 1.5px solid var(--blue-dark);
    border-radius: var(--radius-sm); padding: 0.35rem 0.7rem;
  }
  .header-call { display: flex; flex-direction: column; align-items: center; gap: 2px; flex: none; }
  .header-phone { flex: none; padding: 0.6rem 1rem; font-size: var(--text-sm); }
  .header-response { font-size: 0.68rem; color: var(--text-muted); font-weight: 600; letter-spacing: 0.01em; }
  @media (max-width: 920px) { .header-response { display: none; } }

  .nav-toggle { display: none; }
  .nav-toggle-label { display: none; }

  @media (max-width: 920px) {
    .header-inner { gap: var(--space-3); }
    .site-nav {
      display: none;
      position: absolute; top: 64px; left: 0; right: 0;
      background: #fff; border-bottom: 1px solid var(--border);
      flex-direction: column; align-items: stretch; gap: 0;
      padding: var(--space-2) var(--space-4) var(--space-4);
      box-shadow: var(--shadow-md);
    }
    .site-nav a { padding: 0.75rem 0.25rem; font-size: var(--text-base); border-bottom: 1px solid var(--surface); }
    .site-nav .nav-help { border: none; color: var(--blue-dark); }
    .nav-toggle:checked ~ .site-nav { display: flex; }
    .nav-toggle-label {
      display: flex; flex-direction: column; gap: 5px; justify-content: center;
      width: 40px; height: 40px; padding: 8px; cursor: pointer; margin-left: auto;
    }
    .nav-toggle-label span { display: block; height: 2.5px; background: var(--navy); border-radius: 2px; }
    .header-phone span { display: none; }
    .header-phone { padding: 0.6rem 0.75rem; }
  }
</style>
