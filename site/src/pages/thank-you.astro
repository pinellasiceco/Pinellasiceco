---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
---

<BaseLayout
  pageTitle="Got it — we'll call you back | Pinellas Ice Co"
  metaDescription="Your request was received."
  noIndex={true}
>
  <section class="section">
    <div class="container narrow center">
      <h1>Got it. We'll call you back.</h1>
      <p class="mt-6">
        Your request is in — a real person will get back to you, usually the
        same business day.
      </p>
      <p>
        Machine down and every minute counts? Don't wait on us —
        call now:
      </p>
      <p>
        <a href="tel:+17278556873" class="btn btn-urgent btn-lg">
          <Icon name="phone" size={20} /> (727) 855-6873
        </a>
      </p>
      <p class="mt-8 small muted">
        While you wait: <a href="/ice-machine-troubleshooting/">troubleshooting guide</a> ·
        <a href="/ice-machine-cost-calculator/">cost calculator</a> ·
        <a href="/">home</a>
      </p>
    </div>
  </section>
</BaseLayout>
