---
interface Props {
  title: string;
  description: string;
  slug: string;
  category: string;
  readingTime: string;
  pubDate: Date;
  featured?: boolean;
}

const { title, description, slug, category, readingTime, pubDate, featured = false } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const categoryColor: Record<string, string> = {
  'Migration Guide': 'badge-blue',
  'Platform Selection': 'badge-green',
  'Renewal & Pricing': 'badge-amber',
  'Program Scaling': 'badge-red',
};

const badgeClass = categoryColor[category] || 'badge-blue';
---

<article class={`blog-card card-hover${featured ? ' blog-card-featured' : ''}`}>
  <div class="blog-card-meta">
    <span class={`badge ${badgeClass}`}>{category}</span>
    <span class="blog-card-reading-time">{readingTime}</span>
  </div>
  <h2 class="blog-card-title">
    <a href={`/blog/${slug}`} class="blog-card-link">{title}</a>
  </h2>
  <p class="blog-card-description">{description}</p>
  <div class="blog-card-footer">
    <time datetime={pubDate.toISOString()} class="blog-card-date">{formattedDate}</time>
    <a href={`/blog/${slug}`} class="blog-card-cta" aria-label={`Read: ${title}`}>Read article →</a>
  </div>
</article>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .blog-card-featured {
    border-color: var(--color-accent);
    border-width: 2px;
  }

  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .blog-card-reading-time {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .blog-card-title {
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.35;
    margin: 0;
  }

  .blog-card-link {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .blog-card-link:hover {
    color: var(--color-accent);
  }

  .blog-card-description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    flex: 1;
    margin: 0;
  }

  .blog-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .blog-card-date {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .blog-card-cta {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .blog-card-cta:hover {
    color: var(--color-accent-dark);
  }
</style>
