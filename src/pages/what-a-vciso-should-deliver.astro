---
import BaseLayout from '../components/layout/BaseLayout.astro';
import ConsultationCTA from '../components/ui/ConsultationCTA.astro';
import FAQAccordion from '../components/ui/FAQAccordion.astro';

const faqItems = [
  {
    question: "How much should a vCISO cost?",
    answer: "vCISO pricing varies substantially based on scope and what's actually being delivered. Platform management and compliance operations (running Vanta or Drata, keeping evidence current) typically runs $1,000–$2,500/month. Full GRC program management — policies, risk register, vendor reviews, audit prep coordination — typically runs $2,500–$5,000/month. Strategic security leadership including board reporting, security roadmap ownership, and incident readiness runs $5,000–$10,000+/month. The key question isn't whether the price is fair for a vCISO in the abstract — it's whether the price is fair for what's actually being delivered in your engagement."
  },
  {
    question: "Do I need a vCISO if I have Vanta or Drata?",
    answer: "Vanta and Drata automate evidence collection and test running — they do not own your security program. Someone still needs to manage the platform health, interpret the results, run vendor risk reviews, own the risk register, prepare for audits, and provide security leadership to the business. Whether that person should be a vCISO, an internal hire, or a compliance consultant depends on your program's maturity, your audit frequency, and how much strategic security leadership your business actually needs. For many Series B and earlier companies, a well-scoped GRC program manager (a subset of vCISO services) is more cost-effective than a full vCISO engagement."
  },
  {
    question: "What's the difference between a vCISO and a compliance consultant?",
    answer: "A compliance consultant typically delivers a defined project — a gap assessment, a policy suite, audit preparation support — then exits. A vCISO is an ongoing engagement with program ownership: they're accountable for the health of your security program on a continuing basis, not just for a deliverable. The practical difference shows up in day-to-day activity: a compliance consultant is reactive (you ask, they deliver); a vCISO should be proactive (they identify and raise risks before you ask). The checklist on this page is built around the proactive, ongoing accountability model — the test that distinguishes real vCISO engagements from consulting retainers in disguise."
  },
  {
    question: "Can my vCISO be from my audit firm?",
    answer: "Most major audit firms prohibit their audit staff from providing vCISO or management consulting services to audit clients — it's a conflict of interest under independence rules for SOC 2, ISO 27001, and similar frameworks. If your audit firm is offering vCISO services, you either need a separate firm for the audit, or you need to understand the independence boundary carefully. Some firms have structural separations (a consulting arm separate from the attest practice) that allow both — but you should ask explicitly about independence and get a clear answer before engaging. When in doubt, keep the audit relationship and the vCISO relationship with different organizations."
  },
  {
    question: "How do I switch vCISO providers without disrupting my audit?",
    answer: "The key is documentation continuity. Before a transition, ensure you have: written copies of all program documentation (policies, risk register, vendor assessments, security roadmap) in a format you own and control — not locked in the outgoing provider's systems; a documented transition plan covering what the outgoing provider will hand off and when; and advance notice to your auditor so they're aware a provider change is happening. Most audit-related disruption from vCISO transitions happens when documentation lives in the provider's tools rather than in the client's own systems. The 25-point checklist on this page gives you a concrete transfer checklist to work through before any transition."
  }
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqItems.map(item => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": { "@type": "Answer", "text": item.answer }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "What a vCISO Should Actually Deliver: The Independent Checklist",
    "description": "The independent 25-point checklist of what a virtual CISO engagement should deliver — so you can evaluate any provider or pitch with a concrete standard.",
    "author": { "@type": "Organization", "name": "GRC Migrate Team" },
    "publisher": { "@type": "Organization", "name": "GRC Migrate", "url": "https://grcmigrate.com" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://grcmigrate.com" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://grcmigrate.com/what-a-vciso-should-deliver" },
      { "@type": "ListItem", "position": 3, "name": "vCISO Deliverables Checklist", "item": "https://grcmigrate.com/what-a-vciso-should-deliver" }
    ]
  }
];

const categories = [
  {
    title: "Program Foundations",
    items: [
      "Written security program charter or strategy document exists and is current",
      "Policy suite is complete, approved, and reviewed on a documented schedule",
      "Risk register exists, is prioritized, and was updated in the last quarter",
      "Roles and responsibilities are documented — who owns what, including the vCISO's own scope",
      "A security roadmap exists with quarterly milestones"
    ]
  },
  {
    title: "Ongoing Operations",
    items: [
      "Compliance platform (Vanta, Drata, or other) health is actively managed — failing tests triaged within a defined SLA",
      "Vendor risk reviews happen on schedule with documented outcomes",
      "Access reviews are completed and evidenced quarterly (or per your framework's cadence)",
      "Security awareness training runs on schedule with completion tracking",
      "Evidence collection is current — no scramble before audits"
    ]
  },
  {
    title: "Audit & Framework",
    items: [
      "Audit prep starts 90+ days out with a documented readiness assessment",
      "The vCISO attends auditor calls and manages the evidence request process",
      "Prior audit findings have remediation plans with owners and target dates",
      "Framework changes (e.g., ISO 27001:2022 transition) are tracked and planned for",
      "A gap assessment against your active frameworks exists from the last 12 months"
    ]
  },
  {
    title: "Communication & Leadership",
    items: [
      "You receive a written monthly or quarterly program status report",
      "Board or leadership reporting is produced at an agreed cadence",
      "There is a defined communication channel and response-time expectation for the vCISO",
      "The vCISO proactively raises risks — not just responds to questions",
      "Quarterly business reviews happen and are documented"
    ]
  },
  {
    title: "Incident & Resilience",
    items: [
      "An incident response plan exists and names the vCISO's role in it",
      "The IR plan was tested (tabletop exercise or drill) in the last 12 months",
      "Business continuity and disaster recovery documentation exists and is current",
      "A breach notification process is documented for your regulatory obligations",
      "On-call or escalation expectations for security events are written down and acknowledged"
    ]
  }
];

const totalItems = categories.reduce((sum, c) => sum + c.items.length, 0);
---

<BaseLayout
  pageTitle="What a vCISO Should Actually Deliver: The Independent Checklist | GRC Migrate"
  metaDescription="Confused about what a vCISO actually does? The independent 25-point checklist of what a virtual CISO engagement should deliver — so you can evaluate any provider or pitch."
  canonicalURL="https://grcmigrate.com/what-a-vciso-should-deliver"
  schemaMarkup={schema}
>

<div class="checklist-page">
  <div class="container" style="padding-top:var(--space-12);padding-bottom:var(--space-16)">

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb-sep" aria-hidden="true">›</span>
      <span>Services</span>
      <span class="breadcrumb-sep" aria-hidden="true">›</span>
      <span aria-current="page">vCISO Deliverables Checklist</span>
    </nav>

    <div class="checklist-header">
      <span class="badge badge-blue">Independent Standard</span>
      <h1>What a vCISO Should Actually Deliver: An Independent Checklist</h1>
      <p>The vCISO market grew fast alongside compliance automation platforms. The service is genuinely valuable when scoped well — and genuinely disappointing when it isn't. Most disappointment traces to one root cause: nobody defined what "vCISO" means for this specific engagement. This page fixes that.</p>
    </div>

    <div class="prose" style="max-width:680px;margin-bottom:var(--space-10)">

      <h2>The three things people call "vCISO"</h2>

      <p>Before evaluating any vCISO provider or pitch, it helps to understand that "vCISO" is used to describe at least three meaningfully different service models — and they're priced very differently.</p>

      <div class="vciso-tiers">
        <div class="vciso-tier">
          <div class="vciso-tier-header">
            <span class="badge badge-green">Tier 1</span>
            <h3>Platform management</h3>
          </div>
          <p>"We'll run your Vanta or Drata" — keeping integrations connected, triaging failing tests, maintaining evidence currency. This is legitimate and valuable, but it's compliance operations, not a CISO function. Providers who do this well provide real value; providers who pitch it as strategic security leadership are overselling.</p>
          <p class="vciso-tier-price">Typical value: <strong>$1,000–$2,500/month</strong></p>
        </div>

        <div class="vciso-tier">
          <div class="vciso-tier-header">
            <span class="badge badge-blue">Tier 2</span>
            <h3>GRC program management</h3>
          </div>
          <p>Policies, risk register, vendor risk reviews, audit preparation coordination, framework gap assessments. The most common real deliverable in the market. This is where most mid-market companies actually need help, and where a well-scoped engagement provides strong ROI.</p>
          <p class="vciso-tier-price">Typical value: <strong>$2,500–$5,000/month</strong></p>
        </div>

        <div class="vciso-tier">
          <div class="vciso-tier-header">
            <span class="badge badge-red">Tier 3</span>
            <h3>Strategic security leadership</h3>
          </div>
          <p>Board reporting, security roadmap ownership, incident readiness, architecture input, vendor security oversight at the strategic level. The actual CISO function — and the thing most vCISO pitches imply you're getting.</p>
          <p class="vciso-tier-price">Typical value: <strong>$5,000–$10,000+/month</strong></p>
        </div>
      </div>

      <p>The problem isn't any of these three tiers — it's when providers pitch tier 3 language at tier 3 prices and deliver tier 1 or tier 2 work. That happens not always from bad faith, but from scope that was never written down clearly. The checklist below gives you a concrete standard for what should exist at a full vCISO engagement level.</p>

    </div>

    <div class="checklist-header">
      <h2 style="font-size:var(--text-2xl);font-weight:800;margin-bottom:var(--space-2)">The 25-Point vCISO Deliverables Checklist</h2>
      <p style="color:var(--color-text-secondary);margin-bottom:var(--space-4)">Check what currently exists in your engagement. Use this to evaluate a pitch, audit your current provider, or confirm what your vCISO is delivering.</p>
      <div class="checklist-progress-bar">
        <div class="progress-header">
          <span id="checklist-count">0 of 25 completed</span>
          <div style="display:flex;gap:var(--space-3)">
            <button class="btn btn-outline btn-sm" id="print-btn">Print</button>
            <button class="btn btn-outline btn-sm" id="reset-btn" aria-label="Reset checklist">Reset</button>
          </div>
        </div>
        <div class="progress-bar-container">
          <div class="progress-bar-fill" id="checklist-progress" style="width:0%"></div>
        </div>
      </div>
    </div>

    <div class="checklist-categories" id="checklist-categories">
      {categories.map((cat, ci) => (
        <div class="checklist-category card">
          <h3 class="category-title">{cat.title}</h3>
          <ul class="checklist-items" role="list">
            {cat.items.map((item, ii) => {
              const id = `check-${ci}-${ii}`;
              return (
                <li class="checklist-item">
                  <label class="check-label" for={id}>
                    <input type="checkbox" id={id} class="check-input" />
                    <span class="check-text">{item}</span>
                  </label>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>

    <div class="prose" style="max-width:680px;margin-top:var(--space-12)">
      <h2>How to use this checklist</h2>

      <p><strong>Evaluating a pitch:</strong> Walk through each category with the provider. For every item, ask explicitly: is this in scope for our engagement, and if so, what does delivery look like? Items that aren't in scope aren't a dealbreaker — but they should be explicit exclusions, not silent gaps. Get scope in writing.</p>

      <p><strong>Auditing your current vCISO:</strong> Check what exists today — not what you've been told exists, but what you can see and verify. Score your results:</p>
      <ul>
        <li><strong>20–25:</strong> Strong engagement. You have clear evidence of delivery across the program.</li>
        <li><strong>12–19:</strong> A scope conversation is needed. Identify which categories are thin and address them explicitly.</li>
        <li><strong>Under 12:</strong> You are paying for a title, not a function. The <a href="/vciso-audit">vCISO Audit</a> is designed for this situation.</li>
      </ul>

      <p><strong>If you're a vCISO:</strong> This is the standard. Sharing this checklist with clients and showing them clearly where you stand on each item builds trust and surfaces scope gaps before they become relationship problems. Good vCISOs welcome this kind of transparency.</p>
    </div>

    <div class="vciso-audit-cta">
      <div class="vciso-audit-cta-inner">
        <div>
          <h2 class="vciso-audit-cta-heading">Want an independent read on your vCISO engagement?</h2>
          <p class="vciso-audit-cta-body">The vCISO Audit is a $750 independent review. We assess what your provider has actually delivered against this checklist and give you a written scorecard with a clear verdict — on track, gaps to address, or time for a change.</p>
        </div>
        <a href="/vciso-audit" class="btn btn-primary vciso-audit-cta-btn">Learn About the vCISO Audit →</a>
      </div>
    </div>

    <div class="prose" style="max-width:680px;margin-top:var(--space-12)">
      <h2>Frequently asked questions</h2>
    </div>

    <div style="max-width:680px">
      <FAQAccordion items={faqItems} />
    </div>

    <div style="margin-top:var(--space-12)">
      <ConsultationCTA variant="inline" heading="Not sure how to interpret your checklist results?" />
    </div>

  </div>
</div>

<ConsultationCTA variant="floating" />

</BaseLayout>

<style>
  .checklist-page { background-color: var(--color-surface); }
  .checklist-header { margin: var(--space-6) 0 var(--space-8); }
  .checklist-header h1 { font-size: clamp(1.5rem,4vw,var(--text-3xl)); font-weight: 800; margin: var(--space-3) 0; }
  .checklist-header p { color: var(--color-text-secondary); margin-bottom: var(--space-4); max-width: 680px; }
  .checklist-progress-bar { margin-top: var(--space-4); max-width: 680px; }
  .progress-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-2); }
  #checklist-count { font-size: var(--text-sm); font-weight: 600; color: var(--color-text-primary); }
  .btn-sm { padding: 0.25rem 0.75rem; font-size: var(--text-xs); }
  .checklist-categories { display: flex; flex-direction: column; gap: var(--space-6); max-width: 720px; margin-top: var(--space-6); }
  .checklist-category { padding: var(--space-6); }
  .category-title { font-size: var(--text-base); font-weight: 700; margin-bottom: var(--space-4); color: var(--color-primary); text-transform: uppercase; letter-spacing: 0.05em; font-size: var(--text-sm); }
  .checklist-items { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .checklist-item { border-bottom: 1px solid var(--color-border); padding-bottom: var(--space-3); }
  .checklist-item:last-child { border-bottom: none; padding-bottom: 0; }
  .check-label { display: flex; align-items: flex-start; gap: var(--space-3); cursor: pointer; }
  .check-input { width: 18px; height: 18px; accent-color: var(--color-accent); flex-shrink: 0; margin-top: 2px; cursor: pointer; }
  .check-text { font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.6; }
  .check-label:has(.check-input:checked) .check-text { text-decoration: line-through; color: var(--color-text-muted); }

  .vciso-tiers { display: flex; flex-direction: column; gap: var(--space-4); margin: var(--space-6) 0; }
  .vciso-tier { border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-5); }
  .vciso-tier-header { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3); }
  .vciso-tier-header h3 { font-size: var(--text-base); font-weight: 700; margin: 0; }
  .vciso-tier p { font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.7; margin-bottom: var(--space-2); }
  .vciso-tier-price { font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: 0 !important; }

  .vciso-audit-cta {
    margin-top: var(--space-10);
    background: linear-gradient(135deg, rgba(0,166,126,0.08) 0%, rgba(15,76,129,0.08) 100%);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    max-width: 720px;
  }
  .vciso-audit-cta-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); flex-wrap: wrap; }
  .vciso-audit-cta-heading { font-size: var(--text-xl); font-weight: 800; color: var(--color-text-primary); margin-bottom: var(--space-3); }
  .vciso-audit-cta-body { color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.7; margin: 0; max-width: 480px; }
  .vciso-audit-cta-btn { flex-shrink: 0; }

  @media print {
    .nav-hamburger, .site-header, .site-footer, .cta-floating, #reset-btn, #print-btn { display: none; }
  }
</style>

<script defer>
(function() {
  const total = 25;
  const inputs = document.querySelectorAll('.check-input');
  const countEl = document.getElementById('checklist-count');
  const barEl = document.getElementById('checklist-progress');

  function updateProgress() {
    const checked = document.querySelectorAll('.check-input:checked').length;
    countEl.textContent = `${checked} of ${total} completed`;
    barEl.style.width = Math.round((checked / total) * 100) + '%';
    try { localStorage.setItem('vciso-checklist', JSON.stringify(Array.from(inputs).map(i => i.checked))); } catch(e) {}
  }

  try {
    const saved = JSON.parse(localStorage.getItem('vciso-checklist') || '[]');
    inputs.forEach((input, i) => { if (saved[i]) input.checked = true; });
  } catch(e) {}

  inputs.forEach(input => input.addEventListener('change', updateProgress));
  updateProgress();

  document.getElementById('reset-btn').addEventListener('click', () => {
    inputs.forEach(i => i.checked = false);
    try { localStorage.removeItem('vciso-checklist'); } catch(e) {}
    updateProgress();
  });

  document.getElementById('print-btn').addEventListener('click', () => window.print());
})();
</script>
