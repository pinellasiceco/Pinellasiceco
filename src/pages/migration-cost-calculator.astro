---
import BaseLayout from '../components/layout/BaseLayout.astro';
import ConsultationCTA from '../components/ui/ConsultationCTA.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "GRC Migration Cost Calculator",
  "url": "https://grcmigrate.com/migration-cost-calculator",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "description": "Calculate the real cost of switching GRC platforms vs staying — including labor, integration rebuild, evidence remediation, and break-even analysis."
};
---

<BaseLayout
  pageTitle="GRC Platform Migration Cost Calculator | Switching vs. Staying"
  metaDescription="Calculate the real cost of switching GRC platforms vs. accepting your renewal increase. Includes labor costs, disruption, integration rebuild time, and break-even analysis."
  canonicalURL="https://grcmigrate.com/migration-cost-calculator"
  schemaMarkup={schema}
>

<div class="calc-page">
  <div class="container" style="padding-top:var(--space-12);padding-bottom:var(--space-16)">

    <div class="calc-header">
      <span class="badge badge-blue">Free Calculator</span>
      <h1>Migration Cost Calculator</h1>
      <p>Estimate the real cost of switching GRC platforms vs. accepting your renewal increase. Results update live as you adjust inputs.</p>
    </div>

    <div class="calc-layout">
      <div class="calc-inputs card">

        <h2 class="calc-section-title">Your Current Contract</h2>

        <div class="form-group">
          <label class="form-label" for="current-cost">Current annual platform cost</label>
          <div class="range-with-value">
            <input type="range" id="current-cost" min="5000" max="100000" step="1000" value="20000" class="range-input" />
            <span class="range-value" id="current-cost-val">$20,000</span>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="renewal-pct">Renewal increase (%)</label>
          <div class="range-with-value">
            <input type="range" id="renewal-pct" min="0" max="150" step="5" value="40" class="range-input" />
            <span class="range-value" id="renewal-pct-val">40%</span>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="years">Years before you'd re-evaluate anyway</label>
          <div class="range-with-value">
            <input type="range" id="years" min="1" max="5" step="1" value="3" class="range-input" />
            <span class="range-value" id="years-val">3 years</span>
          </div>
        </div>

        <h2 class="calc-section-title" style="margin-top:var(--space-8)">Switching Costs</h2>

        <div class="form-group">
          <label class="form-label" for="team-members">Team members involved in migration</label>
          <div class="range-with-value">
            <input type="range" id="team-members" min="1" max="15" step="1" value="2" class="range-input" />
            <span class="range-value" id="team-members-val">2 people</span>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="hours-per-person">Estimated hours per team member</label>
          <div class="range-with-value">
            <input type="range" id="hours-per-person" min="10" max="200" step="10" value="60" class="range-input" />
            <span class="range-value" id="hours-per-person-val">60 hours</span>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="hourly-rate">Average fully-loaded hourly cost ($)</label>
          <div class="range-with-value">
            <input type="range" id="hourly-rate" min="50" max="300" step="10" value="120" class="range-input" />
            <span class="range-value" id="hourly-rate-val">$120/hr</span>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="integration-count">Active integrations to reconnect</label>
          <select class="form-select" id="integration-count">
            <option value="1.1">1–5 integrations</option>
            <option value="1.3" selected>6–15 integrations</option>
            <option value="1.5">16–30 integrations</option>
            <option value="1.8">30+ integrations</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="link-evidence">Evidence stored as URL links (not files)</label>
          <select class="form-select" id="link-evidence">
            <option value="0">None — all evidence is uploaded files</option>
            <option value="0.1" selected>Some — under 20% is links</option>
            <option value="0.2">Half — roughly 50% is links</option>
            <option value="0.4">Most — over 50% is links</option>
          </select>
        </div>

      </div><!-- /.calc-inputs -->

      <div class="calc-results">
        <div class="results-row">
          <div class="result-card staying-card">
            <div class="result-card-header staying-header">
              <span>Staying</span>
            </div>
            <div class="result-card-body">
              <div class="result-metric">
                <span class="metric-label">Renewal cost (Year 1)</span>
                <span class="metric-value" id="renewal-cost">—</span>
              </div>
              <div class="result-metric">
                <span class="metric-label">Year 1 increase in dollars</span>
                <span class="metric-value" id="year1-increase">—</span>
              </div>
              <div class="result-metric result-metric-total">
                <span class="metric-label"><strong>3-year total cost</strong></span>
                <span class="metric-value metric-total" id="staying-3yr">—</span>
              </div>
            </div>
          </div>

          <div class="result-card switching-card">
            <div class="result-card-header switching-header">
              <span>Switching</span>
            </div>
            <div class="result-card-body">
              <div class="result-metric">
                <span class="metric-label">Migration labor cost</span>
                <span class="metric-value" id="labor-cost">—</span>
              </div>
              <div class="result-metric">
                <span class="metric-label">Integration rebuild overhead</span>
                <span class="metric-value" id="integration-cost">—</span>
              </div>
              <div class="result-metric">
                <span class="metric-label">Evidence remediation</span>
                <span class="metric-value" id="evidence-cost">—</span>
              </div>
              <div class="result-metric result-metric-total">
                <span class="metric-label"><strong>Total switching cost</strong></span>
                <span class="metric-value metric-total" id="switching-total">—</span>
              </div>
            </div>
          </div>
        </div>

        <div class="breakeven-card card">
          <div class="breakeven-icon">⏱</div>
          <h3 class="breakeven-title">Break-even point</h3>
          <p class="breakeven-value" id="breakeven-text">Calculating...</p>
          <p class="breakeven-note">The point at which switching savings offset the migration cost.</p>
        </div>

        <div class="winner-callout" id="winner-callout">
          <p id="winner-text"></p>
        </div>

        <div class="new-platform-note card" style="background:var(--color-surface)">
          <p style="font-size:var(--text-sm);color:var(--color-text-secondary);margin:0">
            <strong>New platform cost not included:</strong> Your new platform cost will vary based on vendor negotiations. It's typically in a similar range to your current spend, but your specific renewal increase savings apply from Year 1. Factor this into your 3-year comparison.
          </p>
        </div>

      </div><!-- /.calc-results -->
    </div><!-- /.calc-layout -->

    <div class="calc-prose section">
      <div class="container-narrow" style="padding:0">
        <h2>What this calculator doesn't capture</h2>
        <p>The numbers above cover the quantifiable costs well. But several important factors resist easy quantification — and these are often what tip the real decision:</p>
        <p><strong>Compliance risk near an audit.</strong> If a migration runs into unexpected problems within 90 days of your audit — and they sometimes do — the cost isn't in dollars, it's in audit delays, auditor relationship strain, and potential gaps in your compliance posture. This risk is highest in complex migrations and when timing is tight.</p>
        <p><strong>Auditor relationship disruption.</strong> An auditor who has spent 2–3 audit cycles becoming familiar with how your current platform presents evidence will need to re-learn on a new platform. This adds hours to your audit process and occasionally creates friction when evidence format differs from what they expect.</p>
        <p><strong>Integration rebuild complexity beyond time estimates.</strong> The calculator applies a multiplier for integration count, but individual integrations vary dramatically in complexity. One badly-documented custom integration can consume the time budget for 10 standard ones. If your stack includes custom API integrations or non-standard configurations, the actual reconnection time may exceed the model.</p>
        <p><strong>Evidence that won't transfer.</strong> URL-linked evidence has no file to transfer. If the calculator shows a meaningful evidence remediation cost, that reflects a real workflow change your team needs to plan for — not just a one-time cost item.</p>
        <p>A consultation addresses these factors specifically: we look at your integration stack, audit timeline, and evidence storage patterns and give you a risk-adjusted recommendation, not just a cost estimate.</p>
      </div>
    </div>

    <ConsultationCTA variant="inline" />

  </div>
</div>

<ConsultationCTA variant="floating" />

</BaseLayout>

<style>
  .calc-page { background-color: var(--color-surface); }
  .calc-header { text-align: center; margin-bottom: var(--space-10); }
  .calc-header h1 { font-size: var(--text-3xl); font-weight: 800; margin: var(--space-3) 0; }
  .calc-header p { color: var(--color-text-secondary); font-size: var(--text-lg); max-width: 520px; margin: 0 auto; }
  .calc-layout { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-8); align-items: start; }
  @media (max-width: 900px) { .calc-layout { grid-template-columns: 1fr; } }
  .calc-section-title { font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); margin-bottom: var(--space-6); }
  .range-with-value { display: flex; align-items: center; gap: var(--space-4); }
  .range-input { flex: 1; accent-color: var(--color-accent); cursor: pointer; height: 4px; }
  .range-value { font-size: var(--text-sm); font-weight: 700; color: var(--color-accent); min-width: 80px; text-align: right; white-space: nowrap; }
  /* Results */
  .results-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-bottom: var(--space-4); }
  @media (max-width: 500px) { .results-row { grid-template-columns: 1fr; } }
  .result-card { border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; background: white; }
  .result-card-header { padding: var(--space-3) var(--space-4); font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  .staying-header { background-color: rgba(245,158,11,0.1); color: var(--color-warning); }
  .switching-header { background-color: rgba(0,166,126,0.1); color: var(--color-accent-dark); }
  .result-card-body { padding: var(--space-4); }
  .result-metric { display: flex; justify-content: space-between; align-items: baseline; padding: var(--space-2) 0; border-bottom: 1px solid var(--color-border); gap: var(--space-4); }
  .result-metric:last-child { border-bottom: none; }
  .result-metric-total { margin-top: var(--space-2); }
  .metric-label { font-size: var(--text-xs); color: var(--color-text-muted); }
  .metric-value { font-size: var(--text-base); font-weight: 600; color: var(--color-text-primary); white-space: nowrap; }
  .metric-total { font-size: var(--text-xl); color: var(--color-text-primary); }
  .breakeven-card { text-align: center; padding: var(--space-6); margin-bottom: var(--space-4); }
  .breakeven-icon { font-size: 2rem; margin-bottom: var(--space-2); }
  .breakeven-title { font-size: var(--text-base); font-weight: 700; margin-bottom: var(--space-2); }
  .breakeven-value { font-size: var(--text-xl); font-weight: 800; color: var(--color-primary); margin-bottom: var(--space-2); }
  .breakeven-note { font-size: var(--text-xs); color: var(--color-text-muted); margin: 0; }
  .winner-callout { background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.3); border-radius: var(--radius-md); padding: var(--space-4); margin-bottom: var(--space-4); }
  .winner-callout p { font-size: var(--text-sm); color: var(--color-success); font-weight: 600; margin: 0; text-align: center; }
  :root { --space-10: 2.5rem; }
</style>

<script defer>
(function() {
  function fmt(n) {
    return '$' + Math.round(n).toLocaleString('en-US');
  }

  function calc() {
    const current = parseInt(document.getElementById('current-cost').value, 10);
    const renewalPct = parseInt(document.getElementById('renewal-pct').value, 10) / 100;
    const years = parseInt(document.getElementById('years').value, 10);
    const teamMembers = parseInt(document.getElementById('team-members').value, 10);
    const hoursPerPerson = parseInt(document.getElementById('hours-per-person').value, 10);
    const hourlyRate = parseInt(document.getElementById('hourly-rate').value, 10);
    const integrationMult = parseFloat(document.getElementById('integration-count').value);
    const linkMult = parseFloat(document.getElementById('link-evidence').value);

    // Staying
    const renewal = current * (1 + renewalPct);
    const year1Increase = renewal - current;
    const staying3yr = current + renewal * (years - 1);

    // Switching
    const baseLabor = teamMembers * hoursPerPerson * hourlyRate;
    const integrationCost = baseLabor * (integrationMult - 1);
    const evidenceCost = baseLabor * linkMult;
    const switchingTotal = baseLabor + integrationCost + evidenceCost;

    // Break-even
    let breakevenText;
    if (renewalPct <= 0) {
      breakevenText = 'No renewal increase — switching would not save money on platform cost';
    } else {
      const annualSaving = year1Increase;
      const months = Math.round((switchingTotal / annualSaving) * 12);
      if (months <= 6) breakevenText = `Approximately ${months} months`;
      else if (months <= 18) breakevenText = `Approximately ${months} months (${(months / 12).toFixed(1)} years)`;
      else breakevenText = `Approximately ${Math.round(months / 12 * 10) / 10} years — may not be worth switching`;
    }

    // Winner
    const switchingTotal3yr = switchingTotal + current * years;
    const winnerEl = document.getElementById('winner-callout');
    const winnerText = document.getElementById('winner-text');
    if (staying3yr < switchingTotal3yr) {
      winnerText.textContent = '✓ Staying is lower cost over your evaluation window — consider negotiating your renewal.';
      winnerEl.style.backgroundColor = 'rgba(245,158,11,0.08)';
      winnerEl.style.borderColor = 'rgba(245,158,11,0.3)';
      winnerText.style.color = 'var(--color-warning)';
    } else {
      winnerText.textContent = '✓ Switching has lower total cost — if your timeline supports a migration.';
      winnerEl.style.backgroundColor = 'rgba(16,185,129,0.08)';
      winnerEl.style.borderColor = 'rgba(16,185,129,0.3)';
      winnerText.style.color = 'var(--color-success)';
    }

    // Update DOM
    document.getElementById('renewal-cost').textContent = fmt(renewal);
    document.getElementById('year1-increase').textContent = fmt(year1Increase);
    document.getElementById('staying-3yr').textContent = fmt(staying3yr);
    document.getElementById('labor-cost').textContent = fmt(baseLabor);
    document.getElementById('integration-cost').textContent = fmt(integrationCost);
    document.getElementById('evidence-cost').textContent = fmt(evidenceCost);
    document.getElementById('switching-total').textContent = fmt(switchingTotal);
    document.getElementById('breakeven-text').textContent = breakevenText;
  }

  // Range display updates
  document.getElementById('current-cost').addEventListener('input', function() {
    document.getElementById('current-cost-val').textContent = '$' + parseInt(this.value).toLocaleString('en-US');
    calc();
  });
  document.getElementById('renewal-pct').addEventListener('input', function() {
    document.getElementById('renewal-pct-val').textContent = this.value + '%';
    calc();
  });
  document.getElementById('years').addEventListener('input', function() {
    document.getElementById('years-val').textContent = this.value + ' year' + (this.value == 1 ? '' : 's');
    calc();
  });
  document.getElementById('team-members').addEventListener('input', function() {
    document.getElementById('team-members-val').textContent = this.value + ' ' + (this.value == 1 ? 'person' : 'people');
    calc();
  });
  document.getElementById('hours-per-person').addEventListener('input', function() {
    document.getElementById('hours-per-person-val').textContent = this.value + ' hours';
    calc();
  });
  document.getElementById('hourly-rate').addEventListener('input', function() {
    document.getElementById('hourly-rate-val').textContent = '$' + this.value + '/hr';
    calc();
  });
  document.getElementById('integration-count').addEventListener('change', calc);
  document.getElementById('link-evidence').addEventListener('change', calc);

  calc();
})();
</script>
