---
import BaseLayout from '../components/layout/BaseLayout.astro';
import ConsultationCTA from '../components/ui/ConsultationCTA.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "GRC Migration Readiness Assessment",
  "url": "https://grcmigrate.com/migration-assessment",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Any",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Answer 8 questions about your compliance setup and get an instant migration complexity score with a personalized recommendation."
};
---

<BaseLayout
  pageTitle="GRC Migration Readiness Assessment — Free, Instant"
  metaDescription="Answer 8 questions about your compliance setup. Get an instant migration complexity score and personalized summary. Free, no login required. Takes 3 minutes."
  canonicalURL="https://grcmigrate.com/migration-assessment"
  schemaMarkup={schema}
>

<div class="assessment-page">
  <div class="container-narrow" style="padding-top:var(--space-12);padding-bottom:var(--space-16)">

    <div class="assessment-intro">
      <span class="badge badge-green">Free Assessment</span>
      <h1>Migration Readiness Assessment</h1>
      <p>Answer 8 questions about your compliance setup and get an instant complexity score with a personalized recommendation. Takes about 3 minutes. No login required.</p>
      <p class="assessment-crosslink">Migrating from Archer, spreadsheets, or a legacy system? <a href="/legacy-migration-assessment">Take the Legacy Migration Assessment instead →</a></p>
    </div>

    <!-- Assessment card -->
    <div class="assessment-card" id="assessment-card">

      <!-- Progress -->
      <div class="assessment-progress" id="progress-container">
        <div class="progress-header">
          <span class="progress-label" id="progress-label">Question 1 of 8</span>
          <span class="progress-pct" id="progress-pct">0%</span>
        </div>
        <div class="progress-bar-container">
          <div class="progress-bar-fill" id="progress-bar" style="width:0%"></div>
        </div>
      </div>

      <!-- Questions wrapper -->
      <div class="questions-wrapper" id="questions-wrapper">

        <!-- Q1 -->
        <div class="question active" id="q1" data-question="1">
          <p class="question-text">Which platform are you currently on?</p>
          <div class="radio-group" role="radiogroup" aria-label="Current platform">
            <label class="radio-option"><input type="radio" name="q1" value="Vanta"> <span>Vanta</span></label>
            <label class="radio-option"><input type="radio" name="q1" value="Drata"> <span>Drata</span></label>
            <label class="radio-option"><input type="radio" name="q1" value="Archer"> <span>Archer or other enterprise GRC</span></label>
            <label class="radio-option"><input type="radio" name="q1" value="Other"> <span>Other GRC platform</span></label>
            <label class="radio-option"><input type="radio" name="q1" value="Evaluating"> <span>Not sure yet — evaluating options</span></label>
          </div>
        </div>

        <!-- Q2 — not scored, program management -->
        <div class="question" id="q2" data-question="2">
          <p class="question-text">How is your compliance program currently managed?</p>
          <div class="radio-group" role="radiogroup" aria-label="Program management">
            <label class="radio-option"><input type="radio" name="q2" value="Internal team member"> <span>Internal team member owns it</span></label>
            <label class="radio-option"><input type="radio" name="q2" value="vCISO"> <span>A vCISO or fractional security leader</span></label>
            <label class="radio-option"><input type="radio" name="q2" value="Consultant or MSP"> <span>An outside consultant or MSP</span></label>
            <label class="radio-option"><input type="radio" name="q2" value="Nobody clearly"> <span>Honestly, nobody owns it clearly</span></label>
          </div>
        </div>

        <!-- Q3 -->
        <div class="question" id="q3" data-question="3">
          <p class="question-text">How many compliance frameworks are currently active in your program?</p>
          <div class="radio-group" role="radiogroup" aria-label="Framework count">
            <label class="radio-option"><input type="radio" name="q3" value="0" data-score="0"> <span>1 framework — e.g. SOC 2 only</span></label>
            <label class="radio-option"><input type="radio" name="q3" value="1" data-score="1"> <span>2 frameworks — e.g. SOC 2 + ISO 27001</span></label>
            <label class="radio-option"><input type="radio" name="q3" value="3" data-score="3"> <span>3 or more frameworks</span></label>
          </div>
        </div>

        <!-- Q4 -->
        <div class="question" id="q4" data-question="4">
          <p class="question-text">How long have you been on your current platform?</p>
          <div class="radio-group" role="radiogroup" aria-label="Platform tenure">
            <label class="radio-option"><input type="radio" name="q4" value="0" data-score="0"> <span>Less than 1 year</span></label>
            <label class="radio-option"><input type="radio" name="q4" value="2" data-score="2"> <span>1 to 2 years</span></label>
            <label class="radio-option"><input type="radio" name="q4" value="3" data-score="3"> <span>More than 2 years</span></label>
          </div>
        </div>

        <!-- Q5 -->
        <div class="question" id="q5" data-question="5">
          <p class="question-text">When is your next compliance audit or contract renewal?</p>
          <div class="radio-group" role="radiogroup" aria-label="Audit timeline">
            <label class="radio-option"><input type="radio" name="q5" value="0" data-score="0"> <span>More than 6 months away</span></label>
            <label class="radio-option"><input type="radio" name="q5" value="2" data-score="2"> <span>3 to 6 months away</span></label>
            <label class="radio-option"><input type="radio" name="q5" value="3" data-score="3"> <span>Less than 3 months away</span></label>
          </div>
        </div>

        <!-- Q6 -->
        <div class="question" id="q6" data-question="6">
          <p class="question-text">How large is your organization?</p>
          <div class="radio-group" role="radiogroup" aria-label="Organization size">
            <label class="radio-option"><input type="radio" name="q6" value="0" data-score="0"> <span>Under 50 employees</span></label>
            <label class="radio-option"><input type="radio" name="q6" value="1" data-score="1"> <span>50 to 200 employees</span></label>
            <label class="radio-option"><input type="radio" name="q6" value="2" data-score="2"> <span>Over 200 employees</span></label>
          </div>
        </div>

        <!-- Q7 -->
        <div class="question" id="q7" data-question="7">
          <p class="question-text">What is your primary reason for considering a switch?</p>
          <div class="radio-group" role="radiogroup" aria-label="Switch reason">
            <label class="radio-option"><input type="radio" name="q7" value="0" data-score="0"> <span>Renewal pricing — my renewal quote was higher than expected</span></label>
            <label class="radio-option"><input type="radio" name="q7" value="1" data-score="1"> <span>Missing features or integrations — the platform doesn't do what I need</span></label>
            <label class="radio-option"><input type="radio" name="q7" value="2" data-score="2"> <span>Support or audit experience — something went wrong and trust is broken</span></label>
            <label class="radio-option"><input type="radio" name="q7" value="0" data-score="0"> <span>First-time evaluation — I haven't chosen a platform yet</span></label>
          </div>
        </div>

        <!-- Q8 -->
        <div class="question" id="q8" data-question="8">
          <p class="question-text">How is most of your compliance evidence stored?</p>
          <div class="radio-group" role="radiogroup" aria-label="Evidence storage">
            <label class="radio-option"><input type="radio" name="q8" value="0" data-score="0"> <span>Mostly uploaded files — documents and screenshots stored in the platform</span></label>
            <label class="radio-option"><input type="radio" name="q8" value="1" data-score="1"> <span>A mix — some files, some URL links to external systems</span></label>
            <label class="radio-option"><input type="radio" name="q8" value="2" data-score="2"> <span>Mostly URL links — evidence points to external tools rather than uploaded files</span></label>
            <label class="radio-option"><input type="radio" name="q8" value="1" data-score="1"> <span>I'm not sure</span></label>
          </div>
        </div>

        <!-- Q9 -->
        <div class="question" id="q9" data-question="9">
          <p class="question-text">What is your role?</p>
          <div class="radio-group" role="radiogroup" aria-label="Role">
            <label class="radio-option"><input type="radio" name="q9" value="Security Manager"> <span>Security Manager</span></label>
            <label class="radio-option"><input type="radio" name="q9" value="IT Director"> <span>IT Director</span></label>
            <label class="radio-option"><input type="radio" name="q9" value="CISO"> <span>CISO</span></label>
            <label class="radio-option"><input type="radio" name="q9" value="Compliance Manager"> <span>Compliance Manager</span></label>
            <label class="radio-option"><input type="radio" name="q9" value="Founder or CEO"> <span>Founder or CEO</span></label>
            <label class="radio-option"><input type="radio" name="q9" value="Consultant"> <span>Consultant</span></label>
            <label class="radio-option"><input type="radio" name="q9" value="Other"> <span>Other</span></label>
          </div>
        </div>

      </div><!-- /.questions-wrapper -->

      <!-- Lead gate (hidden until Q8 answered) -->
      <div class="lead-gate" id="lead-gate" hidden>
        <div class="gate-teaser">
          <div class="gate-score-badge" id="gate-score-badge"></div>
          <p class="gate-tier-line" id="gate-tier-line"></p>
          <p class="gate-sub">Enter your details below to see your full personalized report.</p>
        </div>

        <form
          class="gate-form"
          name="migration-assessment"
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          id="assessment-form"
        >
          <input type="hidden" name="form-name" value="migration-assessment" />
          <input type="text" name="bot-field" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="score" id="hidden-score" />
          <input type="hidden" name="tier" id="hidden-tier" />
          <input type="hidden" name="q1_platform" id="hidden-q1" />
          <input type="hidden" name="q2_program_management" id="hidden-q2" />
          <input type="hidden" name="q3_frameworks" id="hidden-q3" />
          <input type="hidden" name="q4_tenure" id="hidden-q4" />
          <input type="hidden" name="q5_timeline" id="hidden-q5" />
          <input type="hidden" name="q6_size" id="hidden-q6" />
          <input type="hidden" name="q7_reason" id="hidden-q7" />
          <input type="hidden" name="q8_evidence" id="hidden-q8" />
          <input type="hidden" name="q9_role" id="hidden-q9" />

          <div class="gate-form-grid">
            <div class="form-group">
              <label class="form-label" for="full-name">Full Name <span aria-hidden="true">*</span></label>
              <input class="form-input" type="text" id="full-name" name="full_name" required autocomplete="name" />
            </div>
            <div class="form-group">
              <label class="form-label" for="role-field">Role <span aria-hidden="true">*</span></label>
              <input class="form-input" type="text" id="role-field" name="role" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="company-name">Company Name <span aria-hidden="true">*</span></label>
              <input class="form-input" type="text" id="company-name" name="company_name" required autocomplete="organization" />
            </div>
            <div class="form-group">
              <label class="form-label" for="company-size">Company Size <span aria-hidden="true">*</span></label>
              <select class="form-select" id="company-size" name="company_size" required>
                <option value="">Select...</option>
                <option>1–10</option>
                <option>11–50</option>
                <option>51–200</option>
                <option>201–500</option>
                <option>501–1000</option>
                <option>1000+</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="work-email">Work Email <span aria-hidden="true">*</span></label>
              <input class="form-input" type="email" id="work-email" name="email" required autocomplete="email" />
            </div>
            <div class="form-group">
              <label class="form-label" for="phone">Phone Number <span class="form-hint" style="font-weight:400">(optional)</span></label>
              <input class="form-input" type="tel" id="phone" name="phone" autocomplete="tel" />
            </div>
          </div>

          <button type="submit" class="btn btn-primary gate-submit">Get My Full Migration Report →</button>
          <p class="gate-fine-print">We'll email you a copy. Independent advice — no vendor bias. Unsubscribe anytime.</p>
        </form>
      </div><!-- /.lead-gate -->

      <!-- Results (hidden until form submitted) -->
      <div class="results-section" id="results-section" hidden>
        <div id="results-content"></div>

        <div class="results-next">
          <h3>What happens next</h3>
          <ol class="step-ol">
            <li>We'll review your assessment before the call</li>
            <li>30-minute consultation mapped to your specific situation</li>
            <li>You leave with a clear recommendation and next steps — regardless of what you decide</li>
          </ol>
          <a href="https://CALENDLY_PLACEHOLDER" class="btn btn-primary" rel="noopener" style="margin-top:var(--space-6)">Book Free Consultation →</a>
        </div>
      </div>

    </div><!-- /.assessment-card -->

  </div>
</div>

<ConsultationCTA variant="floating" />

</BaseLayout>

<style>
  .assessment-page { background-color: var(--color-surface); min-height: 80vh; }
  .assessment-intro { text-align: center; margin-bottom: var(--space-8); }
  .assessment-intro h1 { font-size: var(--text-3xl); font-weight: 800; margin: var(--space-3) 0; }
  .assessment-intro p { color: var(--color-text-secondary); font-size: var(--text-lg); max-width: 520px; margin: 0 auto var(--space-2); }
  .assessment-crosslink { font-size: var(--text-sm) !important; color: var(--color-text-muted) !important; }
  .assessment-crosslink a { color: var(--color-accent); }
  .assessment-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    padding: var(--space-8);
    overflow: hidden;
  }
  .assessment-progress { margin-bottom: var(--space-8); }
  .progress-header { display: flex; justify-content: space-between; margin-bottom: var(--space-2); font-size: var(--text-sm); font-weight: 600; }
  .progress-label { color: var(--color-text-primary); }
  .progress-pct { color: var(--color-accent); }
  .questions-wrapper { position: relative; }
  .question { display: none; animation: fadeSlide 0.25s ease; }
  .question.active { display: block; }
  @keyframes fadeSlide { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  .question-text { font-size: var(--text-lg); font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-6); line-height: 1.4; }
  .radio-group { display: flex; flex-direction: column; gap: var(--space-3); }
  .radio-option {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: border-color 0.15s, background-color 0.15s;
    font-size: var(--text-base);
    line-height: 1.4;
  }
  .radio-option:hover { border-color: var(--color-accent); background-color: rgba(0,166,126,0.03); }
  .radio-option input[type="radio"] { accent-color: var(--color-accent); flex-shrink: 0; width: 18px; height: 18px; }
  .radio-option:has(input:checked) { border-color: var(--color-accent); background-color: rgba(0,166,126,0.06); }
  /* Lead gate */
  .lead-gate { border-top: 1px solid var(--color-border); padding-top: var(--space-8); margin-top: var(--space-4); }
  .gate-teaser { text-align: center; margin-bottom: var(--space-8); }
  .gate-score-badge { display: inline-block; font-size: var(--text-xl); font-weight: 800; padding: var(--space-3) var(--space-6); border-radius: var(--radius-lg); margin-bottom: var(--space-4); }
  .gate-tier-line { font-size: var(--text-lg); font-weight: 600; color: var(--color-text-primary); margin-bottom: var(--space-2); }
  .gate-sub { color: var(--color-text-secondary); }
  .gate-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-bottom: var(--space-6); }
  @media (max-width: 600px) { .gate-form-grid { grid-template-columns: 1fr; } }
  .gate-submit { width: 100%; padding: 0.875rem; font-size: var(--text-base); }
  .gate-fine-print { text-align: center; font-size: var(--text-xs); color: var(--color-text-muted); margin-top: var(--space-3); }
  /* Results */
  .results-section { border-top: 1px solid var(--color-border); padding-top: var(--space-8); margin-top: var(--space-4); }
  .results-next { background: var(--color-surface); border-radius: var(--radius-lg); padding: var(--space-6); margin-top: var(--space-8); }
  .results-next h3 { font-size: var(--text-lg); font-weight: 700; margin-bottom: var(--space-4); }
  .step-ol { padding-left: var(--space-6); display: flex; flex-direction: column; gap: var(--space-2); color: var(--color-text-secondary); }
</style>

<script defer>
(function() {
  const answers = {};
  let currentQ = 1;
  const totalQ = 9;

  function updateProgress(q) {
    const pct = Math.round(((q - 1) / totalQ) * 100);
    document.getElementById('progress-label').textContent = `Question ${q} of ${totalQ}`;
    document.getElementById('progress-pct').textContent = pct + '%';
    document.getElementById('progress-bar').style.width = pct + '%';
  }

  function showQuestion(q) {
    document.querySelectorAll('.question').forEach(el => el.classList.remove('active'));
    const el = document.getElementById('q' + q);
    if (el) el.classList.add('active');
    updateProgress(q);
    currentQ = q;
  }

  function getScore() {
    let score = 0;
    // Q1 and Q2 are unscored; scored questions are Q3-Q8
    for (let i = 3; i <= 8; i++) {
      const checked = document.querySelector(`input[name="q${i}"]:checked`);
      if (checked) score += parseInt(checked.dataset.score || '0', 10);
    }
    return score;
  }

  function getTier(score) {
    if (score <= 4) return 'SIMPLE';
    if (score <= 8) return 'MODERATE';
    return 'COMPLEX';
  }

  function buildResults(tier, platform, frameworks, timeline, role, programMgmt) {
    const guideLink = platform === 'Vanta' ? '/vanta-to-drata-migration' : '/drata-to-vanta-migration';
    const guideName = platform === 'Vanta' ? 'Vanta to Drata Migration Guide' : 'Drata to Vanta Migration Guide';
    const vcisaNote = programMgmt === 'vCISO' ? `<p style="margin-top:var(--space-4);font-size:var(--text-sm);color:var(--color-text-secondary);border-left:3px solid var(--color-accent);padding-left:var(--space-4)">Since a vCISO manages your program, make sure they're central to the migration plan — and if you're not certain about the engagement itself, the <a href="/what-a-vciso-should-deliver">independent vCISO checklist</a> is worth a look.</p>` : '';

    if (tier === 'SIMPLE') {
      return `
        <div style="margin-bottom:var(--space-6)">
          <span class="badge badge-green" style="font-size:var(--text-base);padding:0.5rem 1.25rem">SIMPLE</span>
          <h2 style="font-size:var(--text-2xl);font-weight:800;margin:var(--space-4) 0 var(--space-3)">Your migration looks straightforward — but planning still matters.</h2>
          <p style="color:var(--color-text-secondary);line-height:1.8">With your current setup${platform && platform !== 'Evaluating' ? ' on ' + platform : ''} and ${timeline === '0' ? 'more than 6 months' : timeline === '2' ? '3 to 6 months' : 'less than 3 months'} before your next audit, your migration falls into the straightforward category. The core data migration can typically be completed in 3–4 weeks. The biggest risks for your situation are integration reconnection time and the 24–48 hour stabilization window after reconnection when automated tests re-run against your environment.</p>
          <ul class="checklist" style="margin-top:var(--space-6)">
            <li>Expected timeline: <strong>3–4 weeks</strong> active migration work</li>
            <li>Biggest risk: Integration reconnection time and test stabilization window</li>
            <li>Key action: Plan the migration outside your audit window — minimum 6 weeks of runway recommended</li>
          </ul>
        </div>
        <div class="highlight-box">
          <h3 style="font-weight:700;margin-bottom:var(--space-3)">Even straightforward migrations have surprises.</h3>
          <p style="color:var(--color-text-secondary);margin-bottom:var(--space-4)">A 30-minute consultation will map your specific integration stack, flag any evidence stored as links that won't transfer, and give you a week-by-week migration plan. Clients in your complexity tier typically tell us it saved them 2–3 weeks of trial and error.</p>
          <a href="https://CALENDLY_PLACEHOLDER" class="btn btn-primary" rel="noopener">Book Free Consultation →</a>
        </div>
        ${vcisaNote}
        ${platform && platform !== 'Evaluating' ? `<p style="margin-top:var(--space-4)"><a href="${guideLink}">${guideName} →</a></p>` : ''}
      `;
    }

    if (tier === 'MODERATE') {
      return `
        <div style="margin-bottom:var(--space-6)">
          <span class="badge badge-amber" style="font-size:var(--text-base);padding:0.5rem 1.25rem">MODERATE</span>
          <h2 style="font-size:var(--text-2xl);font-weight:800;margin:var(--space-4) 0 var(--space-3)">Your migration has variables that need a documented plan.</h2>
          <p style="color:var(--color-text-secondary);line-height:1.8">Your profile puts this in the moderate-complexity category. The main risks in your situation involve evidence portability, integration reconnection overhead, and audit timeline proximity. Attempting this without a phased plan risks compliance gaps that surface at your next audit.</p>
          <ul class="checklist" style="margin-top:var(--space-6)">
            <li>Expected timeline: <strong>5–8 weeks</strong> with proper planning</li>
            <li>Key risk: Evidence stored as URL links won't transfer automatically</li>
            <li>Auditor communication required at least <strong>60 days</strong> before next audit</li>
          </ul>
        </div>
        <div class="highlight-box">
          <h3 style="font-weight:700;margin-bottom:var(--space-3)">Moderate migrations are where we see the most preventable failures.</h3>
          <p style="color:var(--color-text-secondary);margin-bottom:var(--space-4)">The difference between a clean migration and one that creates audit problems is almost always planning depth and sequencing. A consultation produces a phased migration plan specific to your integration stack, an evidence gap analysis, and a communication plan for your auditor.</p>
          <a href="https://CALENDLY_PLACEHOLDER" class="btn btn-primary" rel="noopener">Book Free Consultation →</a>
        </div>
        ${vcisaNote}
        ${platform && platform !== 'Evaluating' ? `<p style="margin-top:var(--space-4)"><a href="${guideLink}">${guideName} →</a></p>` : ''}
      `;
    }

    // COMPLEX
    return `
      <div style="margin-bottom:var(--space-6)">
        <span class="badge badge-red" style="font-size:var(--text-base);padding:0.5rem 1.25rem">COMPLEX</span>
        <h2 style="font-size:var(--text-2xl);font-weight:800;margin:var(--space-4) 0 var(--space-3)">Your migration has significant risk factors. Don't attempt this without a roadmap.</h2>
        <p style="color:var(--color-text-secondary);line-height:1.8">Your profile puts this in the complex category. Complex migrations at this level have a high probability of creating compliance gaps if attempted without careful sequencing, stakeholder alignment, and advance auditor communication. This is not a weekend project.</p>
        <div style="margin-top:var(--space-6)">
          <h3 style="font-weight:700;margin-bottom:var(--space-3)">Your key risk factors:</h3>
          <ul class="checklist">
            <li>Multiple active frameworks increase control re-mapping complexity significantly</li>
            <li>Evidence continuity plan required — auditor needs documented transition approach</li>
            <li>Integration rebuild time likely exceeds initial estimates — budget 2x</li>
          </ul>
        </div>
        <p style="color:var(--color-text-secondary);margin-top:var(--space-4)"><strong>Timeline:</strong> Complex migrations at your profile typically take <strong>10–14 weeks</strong> from kick-off to decommissioning the source platform.</p>
      </div>
      <div style="background:var(--color-primary);border-radius:var(--radius-lg);padding:var(--space-6);color:white;margin-bottom:var(--space-4)">
        <h3 style="font-weight:700;margin-bottom:var(--space-3);color:white">This is not a DIY migration.</h3>
        <p style="color:rgba(255,255,255,0.85);margin-bottom:var(--space-4)">At this complexity level, the cost of getting it wrong — audit delays, evidence gaps, stakeholder disruption — significantly exceeds the cost of getting expert help upfront. A consultation will assess whether your timeline is viable and build the risk register your auditor will need.</p>
        <a href="https://CALENDLY_PLACEHOLDER" class="btn btn-white" rel="noopener">Book Free Consultation — Time-Sensitive →</a>
      </div>
      ${vcisaNote}
      ${platform && platform !== 'Evaluating' ? `<p style="margin-top:var(--space-4)"><a href="${guideLink}">${guideName} →</a></p>` : ''}
    `;
  }

  // Auto-advance on radio selection
  document.querySelectorAll('.radio-option input[type="radio"]').forEach(radio => {
    radio.addEventListener('change', () => {
      const qNum = parseInt(radio.closest('.question').dataset.question, 10);
      answers['q' + qNum] = radio.value;

      // Small delay so user sees selection
      setTimeout(() => {
        if (qNum < totalQ) {
          showQuestion(qNum + 1);
        } else {
          // All questions answered — show gate
          showGate();
        }
      }, 350);
    });
  });

  function showGate() {
    document.getElementById('progress-label').textContent = 'Almost done!';
    document.getElementById('progress-pct').textContent = '100%';
    document.getElementById('progress-bar').style.width = '100%';

    document.getElementById('questions-wrapper').hidden = true;

    const score = getScore();
    const tier = getTier(score);

    const badge = document.getElementById('gate-score-badge');
    const tierLine = document.getElementById('gate-tier-line');

    const tierColors = { SIMPLE: '#10B981', MODERATE: '#F59E0B', COMPLEX: '#EF4444' };
    badge.textContent = tier;
    badge.style.backgroundColor = tierColors[tier] + '20';
    badge.style.color = tierColors[tier];
    badge.style.border = '2px solid ' + tierColors[tier];
    tierLine.textContent = `Based on your answers, your migration complexity is ${tier}.`;

    // Pre-fill role
    const roleField = document.getElementById('role-field');
    if (roleField && answers.q9) roleField.value = answers.q9;

    // Set hidden fields
    document.getElementById('hidden-score').value = score;
    document.getElementById('hidden-tier').value = tier;
    document.getElementById('hidden-q1').value = answers.q1 || '';
    document.getElementById('hidden-q2').value = answers.q2 || '';
    document.getElementById('hidden-q3').value = answers.q3 || '';
    document.getElementById('hidden-q4').value = answers.q4 || '';
    document.getElementById('hidden-q5').value = answers.q5 || '';
    document.getElementById('hidden-q6').value = answers.q6 || '';
    document.getElementById('hidden-q7').value = answers.q7 || '';
    document.getElementById('hidden-q8').value = answers.q8 || '';
    document.getElementById('hidden-q9').value = answers.q9 || '';

    document.getElementById('lead-gate').hidden = false;
  }

  // Form submit — show results inline
  document.getElementById('assessment-form').addEventListener('submit', function(e) {
    e.preventDefault();

    const score = parseInt(document.getElementById('hidden-score').value, 10);
    const tier = getTier(score);
    const platform = document.getElementById('hidden-q1').value;
    const programMgmt = document.getElementById('hidden-q2').value;
    const frameworks = document.getElementById('hidden-q3').value;
    const timeline = document.getElementById('hidden-q5').value;
    const role = document.getElementById('hidden-q9').value;

    // Submit to Netlify in background
    const formData = new FormData(this);
    fetch('/', { method: 'POST', body: formData }).catch(() => {});

    // Hide gate, show results
    document.getElementById('lead-gate').hidden = true;
    const resultsSection = document.getElementById('results-section');
    document.getElementById('results-content').innerHTML = buildResults(tier, platform, frameworks, timeline, role, programMgmt);
    resultsSection.hidden = false;
    resultsSection.scrollIntoView({ behavior: 'smooth' });
  });

  // Init
  showQuestion(1);
})();
</script>
