---
import BaseLayout from '../components/layout/BaseLayout.astro';
import ConsultationCTA from '../components/ui/ConsultationCTA.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Legacy GRC Migration Complexity Assessment",
  "url": "https://grcmigrate.com/legacy-migration-assessment",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Any",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Answer 8 questions about your current GRC system and program and get an instant migration complexity score built for teams leaving Archer, spreadsheets, and legacy GRC tools."
};
---

<BaseLayout
  pageTitle="Legacy GRC Migration Assessment — Archer, Spreadsheets & More | Free | GRC Migrate"
  metaDescription="Moving off RSA Archer, spreadsheets, or a legacy GRC tool? Answer 8 questions and get an instant migration complexity score built for legacy system migrations. Free."
  canonicalURL="https://grcmigrate.com/legacy-migration-assessment"
  schemaMarkup={schema}
>

<div class="assessment-page">
  <div class="container-narrow" style="padding-top:var(--space-12);padding-bottom:var(--space-16)">

    <div class="assessment-intro">
      <span class="badge badge-blue">Free Assessment</span>
      <h1>Legacy GRC Migration Assessment</h1>
      <p>Moving off RSA Archer, spreadsheets, or another legacy system? Answer 8 questions and get an instant complexity score built specifically for legacy migrations — not platform-to-platform switches. Takes under 5 minutes.</p>
      <p class="assessment-crosslink">Switching between Vanta and Drata instead? <a href="/migration-assessment">Take the Platform Migration Assessment →</a></p>
    </div>

    <div class="assessment-card" id="assessment-card">

      <div class="assessment-progress" id="progress-container">
        <div class="progress-header">
          <span class="progress-label" id="progress-label">Question 1 of 8</span>
          <span class="progress-pct" id="progress-pct">0%</span>
        </div>
        <div class="progress-bar-container">
          <div class="progress-bar-fill" id="progress-bar" style="width:0%"></div>
        </div>
      </div>

      <div class="questions-wrapper" id="questions-wrapper">

        <!-- Q1 — not scored, personalizes output -->
        <div class="question active" id="q1" data-question="1">
          <p class="question-text">What are you migrating from?</p>
          <div class="radio-group" role="radiogroup" aria-label="Current system">
            <label class="radio-option"><input type="radio" name="q1" value="RSA Archer"> <span>RSA Archer</span></label>
            <label class="radio-option"><input type="radio" name="q1" value="Enterprise GRC"> <span>Another enterprise GRC tool (MetricStream, LogicGate, ServiceNow GRC, or other)</span></label>
            <label class="radio-option"><input type="radio" name="q1" value="Spreadsheets"> <span>Spreadsheets / SharePoint / homegrown system</span></label>
            <label class="radio-option"><input type="radio" name="q1" value="Legacy Tool"> <span>An older compliance tool that's no longer actively developed</span></label>
          </div>
        </div>

        <!-- Q2 — scored -->
        <div class="question" id="q2" data-question="2">
          <p class="question-text">How long has your current system been in place?</p>
          <div class="radio-group" role="radiogroup" aria-label="System age">
            <label class="radio-option"><input type="radio" name="q2" value="Under 2 years" data-score="0"> <span>Under 2 years</span></label>
            <label class="radio-option"><input type="radio" name="q2" value="2-5 years" data-score="1"> <span>2 to 5 years</span></label>
            <label class="radio-option"><input type="radio" name="q2" value="5-10 years" data-score="2"> <span>5 to 10 years</span></label>
            <label class="radio-option"><input type="radio" name="q2" value="Over 10 years" data-score="3"> <span>Over 10 years</span></label>
          </div>
        </div>

        <!-- Q3 — scored -->
        <div class="question" id="q3" data-question="3">
          <p class="question-text">How customized is your current setup?</p>
          <div class="radio-group" role="radiogroup" aria-label="Customization level">
            <label class="radio-option"><input type="radio" name="q3" value="Minimal" data-score="0"> <span>Mostly out-of-the-box / simple sheets with minimal customization</span></label>
            <label class="radio-option"><input type="radio" name="q3" value="Some" data-score="1"> <span>Some custom fields and reports, but nothing too complex</span></label>
            <label class="radio-option"><input type="radio" name="q3" value="Significant" data-score="3"> <span>Significant customization — custom applications, workflows, calculated fields</span></label>
            <label class="radio-option"><input type="radio" name="q3" value="Unknown" data-score="2"> <span>I honestly don't know the full extent of what's been customized</span></label>
          </div>
        </div>

        <!-- Q4 — scored -->
        <div class="question" id="q4" data-question="4">
          <p class="question-text">Is the person who built or currently maintains your system still available?</p>
          <div class="radio-group" role="radiogroup" aria-label="Institutional knowledge">
            <label class="radio-option"><input type="radio" name="q4" value="Yes active" data-score="0"> <span>Yes — actively maintaining it and available for the migration</span></label>
            <label class="radio-option"><input type="radio" name="q4" value="Yes transitioning" data-score="1"> <span>Yes, but transitioning out or stretched thin</span></label>
            <label class="radio-option"><input type="radio" name="q4" value="No left" data-score="3"> <span>No — they've left and knowledge wasn't fully transferred</span></label>
            <label class="radio-option"><input type="radio" name="q4" value="Vendor" data-score="1"> <span>It's maintained by an external vendor or consultant</span></label>
          </div>
        </div>

        <!-- Q5 — scored -->
        <div class="question" id="q5" data-question="5">
          <p class="question-text">How many compliance frameworks does your program currently cover?</p>
          <div class="radio-group" role="radiogroup" aria-label="Framework count">
            <label class="radio-option"><input type="radio" name="q5" value="1" data-score="0"> <span>1 framework</span></label>
            <label class="radio-option"><input type="radio" name="q5" value="2" data-score="1"> <span>2 frameworks</span></label>
            <label class="radio-option"><input type="radio" name="q5" value="3+" data-score="2"> <span>3 or more frameworks</span></label>
          </div>
        </div>

        <!-- Q6 — scored -->
        <div class="question" id="q6" data-question="6">
          <p class="question-text">When is your next audit or major compliance deadline?</p>
          <div class="radio-group" role="radiogroup" aria-label="Audit timeline">
            <label class="radio-option"><input type="radio" name="q6" value="6+ months" data-score="0"> <span>More than 6 months away</span></label>
            <label class="radio-option"><input type="radio" name="q6" value="3-6 months" data-score="2"> <span>3 to 6 months away</span></label>
            <label class="radio-option"><input type="radio" name="q6" value="Under 3 months" data-score="3"> <span>Less than 3 months away</span></label>
          </div>
        </div>

        <!-- Q7 — scored -->
        <div class="question" id="q7" data-question="7">
          <p class="question-text">Roughly how many active records live in your current system? (controls, risks, vendors, and findings combined)</p>
          <div class="radio-group" role="radiogroup" aria-label="Record volume">
            <label class="radio-option"><input type="radio" name="q7" value="Under 200" data-score="0"> <span>Under 200 records</span></label>
            <label class="radio-option"><input type="radio" name="q7" value="200-1000" data-score="1"> <span>200 to 1,000 records</span></label>
            <label class="radio-option"><input type="radio" name="q7" value="1000-10000" data-score="2"> <span>1,000 to 10,000 records</span></label>
            <label class="radio-option"><input type="radio" name="q7" value="Over 10000" data-score="3"> <span>Over 10,000 records / no idea of the count</span></label>
          </div>
        </div>

        <!-- Q8 — not scored, lead qualification -->
        <div class="question" id="q8" data-question="8">
          <p class="question-text">What is your role?</p>
          <div class="radio-group" role="radiogroup" aria-label="Role">
            <label class="radio-option"><input type="radio" name="q8" value="Security Manager"> <span>Security Manager</span></label>
            <label class="radio-option"><input type="radio" name="q8" value="IT Director"> <span>IT Director</span></label>
            <label class="radio-option"><input type="radio" name="q8" value="CISO"> <span>CISO</span></label>
            <label class="radio-option"><input type="radio" name="q8" value="Compliance Manager"> <span>Compliance Manager</span></label>
            <label class="radio-option"><input type="radio" name="q8" value="Founder or CEO"> <span>Founder or CEO</span></label>
            <label class="radio-option"><input type="radio" name="q8" value="Consultant"> <span>Consultant</span></label>
            <label class="radio-option"><input type="radio" name="q8" value="Other"> <span>Other</span></label>
          </div>
        </div>

      </div><!-- /.questions-wrapper -->

      <!-- Lead gate -->
      <div class="lead-gate" id="lead-gate" hidden>
        <div class="gate-teaser">
          <div class="gate-score-badge" id="gate-score-badge"></div>
          <p class="gate-tier-line" id="gate-tier-line"></p>
          <p class="gate-sub">Enter your details below to see your full personalized migration report.</p>
        </div>

        <form
          class="gate-form"
          name="legacy-migration-assessment"
          method="POST"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          id="assessment-form"
        >
          <input type="hidden" name="form-name" value="legacy-migration-assessment" />
          <input type="text" name="bot-field" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="score" id="hidden-score" />
          <input type="hidden" name="tier" id="hidden-tier" />
          <input type="hidden" name="q1_source_system" id="hidden-q1" />
          <input type="hidden" name="q2_system_age" id="hidden-q2" />
          <input type="hidden" name="q3_customization" id="hidden-q3" />
          <input type="hidden" name="q4_knowledge" id="hidden-q4" />
          <input type="hidden" name="q5_frameworks" id="hidden-q5" />
          <input type="hidden" name="q6_timeline" id="hidden-q6" />
          <input type="hidden" name="q7_records" id="hidden-q7" />
          <input type="hidden" name="q8_role" id="hidden-q8" />

          <div class="gate-form-grid">
            <div class="form-group">
              <label class="form-label" for="full-name">Full Name <span aria-hidden="true">*</span></label>
              <input class="form-input" type="text" id="full-name" name="full_name" required autocomplete="name" />
            </div>
            <div class="form-group">
              <label class="form-label" for="role-field">Role <span aria-hidden="true">*</span></label>
              <input class="form-input" type="text" id="role-field" name="role" required />
            </div>
            <div class="form-group">
              <label class="form-label" for="company-name">Company Name <span aria-hidden="true">*</span></label>
              <input class="form-input" type="text" id="company-name" name="company_name" required autocomplete="organization" />
            </div>
            <div class="form-group">
              <label class="form-label" for="company-size">Company Size <span aria-hidden="true">*</span></label>
              <select class="form-select" id="company-size" name="company_size" required>
                <option value="">Select...</option>
                <option>1–10</option>
                <option>11–50</option>
                <option>51–200</option>
                <option>201–500</option>
                <option>501–1000</option>
                <option>1000+</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" for="work-email">Work Email <span aria-hidden="true">*</span></label>
              <input class="form-input" type="email" id="work-email" name="email" required autocomplete="email" />
            </div>
            <div class="form-group">
              <label class="form-label" for="phone">Phone Number <span class="form-hint" style="font-weight:400">(optional)</span></label>
              <input class="form-input" type="tel" id="phone" name="phone" autocomplete="tel" />
            </div>
          </div>

          <button type="submit" class="btn btn-primary gate-submit">Get My Full Migration Report →</button>
          <p class="gate-fine-print">Independent advice — not affiliated with any platform vendor. Unsubscribe anytime.</p>
        </form>
      </div><!-- /.lead-gate -->

      <!-- Results -->
      <div class="results-section" id="results-section" hidden>
        <div id="results-content"></div>

        <div class="results-next">
          <h3>What happens next</h3>
          <ol class="step-ol">
            <li>We'll review your assessment before the call</li>
            <li>30-minute consultation mapped to your specific system and program</li>
            <li>You leave with a clear recommendation and migration plan — regardless of what you decide</li>
          </ol>
          <a href="https://CALENDLY_PLACEHOLDER" class="btn btn-primary" rel="noopener" style="margin-top:var(--space-6)">Book Free Consultation →</a>
        </div>
      </div>

    </div><!-- /.assessment-card -->

  </div>
</div>

<ConsultationCTA variant="floating" />

</BaseLayout>

<style>
  .assessment-page { background-color: var(--color-surface); min-height: 80vh; }
  .assessment-intro { text-align: center; margin-bottom: var(--space-8); }
  .assessment-intro h1 { font-size: var(--text-3xl); font-weight: 800; margin: var(--space-3) 0; }
  .assessment-intro p { color: var(--color-text-secondary); font-size: var(--text-lg); max-width: 560px; margin: 0 auto var(--space-2); }
  .assessment-crosslink { font-size: var(--text-sm) !important; color: var(--color-text-muted) !important; }
  .assessment-crosslink a { color: var(--color-accent); }
  .assessment-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    padding: var(--space-8);
    overflow: hidden;
  }
  .assessment-progress { margin-bottom: var(--space-8); }
  .progress-header { display: flex; justify-content: space-between; margin-bottom: var(--space-2); font-size: var(--text-sm); font-weight: 600; }
  .progress-label { color: var(--color-text-primary); }
  .progress-pct { color: var(--color-accent); }
  .questions-wrapper { position: relative; }
  .question { display: none; animation: fadeSlide 0.25s ease; }
  .question.active { display: block; }
  @keyframes fadeSlide { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  .question-text { font-size: var(--text-lg); font-weight: 700; color: var(--color-text-primary); margin-bottom: var(--space-6); line-height: 1.4; }
  .radio-group { display: flex; flex-direction: column; gap: var(--space-3); }
  .radio-option {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: border-color 0.15s, background-color 0.15s;
    font-size: var(--text-base);
    line-height: 1.4;
  }
  .radio-option:hover { border-color: var(--color-accent); background-color: rgba(0,166,126,0.03); }
  .radio-option input[type="radio"] { accent-color: var(--color-accent); flex-shrink: 0; width: 18px; height: 18px; }
  .radio-option:has(input:checked) { border-color: var(--color-accent); background-color: rgba(0,166,126,0.06); }
  .lead-gate { border-top: 1px solid var(--color-border); padding-top: var(--space-8); margin-top: var(--space-4); }
  .gate-teaser { text-align: center; margin-bottom: var(--space-8); }
  .gate-score-badge { display: inline-block; font-size: var(--text-xl); font-weight: 800; padding: var(--space-3) var(--space-6); border-radius: var(--radius-lg); margin-bottom: var(--space-4); }
  .gate-tier-line { font-size: var(--text-lg); font-weight: 600; color: var(--color-text-primary); margin-bottom: var(--space-2); }
  .gate-sub { color: var(--color-text-secondary); }
  .gate-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-bottom: var(--space-6); }
  @media (max-width: 600px) { .gate-form-grid { grid-template-columns: 1fr; } }
  .gate-submit { width: 100%; padding: 0.875rem; font-size: var(--text-base); }
  .gate-fine-print { text-align: center; font-size: var(--text-xs); color: var(--color-text-muted); margin-top: var(--space-3); }
  .results-section { border-top: 1px solid var(--color-border); padding-top: var(--space-8); margin-top: var(--space-4); }
  .results-next { background: var(--color-surface); border-radius: var(--radius-lg); padding: var(--space-6); margin-top: var(--space-8); }
  .results-next h3 { font-size: var(--text-lg); font-weight: 700; margin-bottom: var(--space-4); }
  .step-ol { padding-left: var(--space-6); display: flex; flex-direction: column; gap: var(--space-2); color: var(--color-text-secondary); }
</style>

<script defer>
(function() {
  const answers = {};
  let currentQ = 1;
  const totalQ = 8;

  function updateProgress(q) {
    const pct = Math.round(((q - 1) / totalQ) * 100);
    document.getElementById('progress-label').textContent = `Question ${q} of ${totalQ}`;
    document.getElementById('progress-pct').textContent = pct + '%';
    document.getElementById('progress-bar').style.width = pct + '%';
  }

  function showQuestion(q) {
    document.querySelectorAll('.question').forEach(el => el.classList.remove('active'));
    const el = document.getElementById('q' + q);
    if (el) el.classList.add('active');
    updateProgress(q);
    currentQ = q;
  }

  function getScore() {
    let score = 0;
    // Q2-Q7 are scored; Q1 and Q8 are not
    for (let i = 2; i <= 7; i++) {
      const checked = document.querySelector(`input[name="q${i}"]:checked`);
      if (checked) score += parseInt(checked.dataset.score || '0', 10);
    }
    return score;
  }

  function getTier(score) {
    if (score <= 5) return 'MANAGEABLE';
    if (score <= 10) return 'SUBSTANTIAL';
    return 'COMPLEX';
  }

  function getSystemLabel(q1) {
    const map = {
      'RSA Archer': 'RSA Archer',
      'Enterprise GRC': 'your enterprise GRC system',
      'Spreadsheets': 'your spreadsheet-based program',
      'Legacy Tool': 'your legacy compliance tool'
    };
    return map[q1] || 'your current system';
  }

  function buildResults(tier, q1, q3, q4, q6, role) {
    const systemLabel = getSystemLabel(q1);
    const knowledgeGap = q4 === 'No left';
    const shortTimeline = q6 === 'Under 3 months';
    const highCustom = q3 === 'Significant' || q3 === 'Unknown';

    const guideLink = q1 === 'RSA Archer' ? '/archer-to-vanta-migration' : '/legacy-migration-assessment';
    const guideName = q1 === 'RSA Archer' ? 'Archer to Vanta Migration Guide' : 'Legacy Migration Assessment Guide';

    if (tier === 'MANAGEABLE') {
      return `
        <div style="margin-bottom:var(--space-6)">
          <span class="badge badge-green" style="font-size:var(--text-base);padding:0.5rem 1.25rem">MANAGEABLE</span>
          <h2 style="font-size:var(--text-2xl);font-weight:800;margin:var(--space-4) 0 var(--space-3)">Your migration is very achievable — and probably overdue.</h2>
          <p style="color:var(--color-text-secondary);line-height:1.8">Based on your answers, migrating from ${systemLabel} falls into the manageable category. With low customization and available institutional knowledge, this is primarily a planning exercise — not a months-long project. The biggest risk at this level isn't complexity; it's choosing the wrong destination platform and having to migrate twice.</p>
          <ul class="checklist" style="margin-top:var(--space-6)">
            <li>Expected timeline: <strong>4–8 weeks</strong> from decision to fully operational on the new platform</li>
            <li>Biggest risk: Platform selection — make sure the modern tool fits your program before committing</li>
            <li>Key action: Do a quick platform comparison before signing anything</li>
          </ul>
        </div>
        <div class="highlight-box">
          <h3 style="font-weight:700;margin-bottom:var(--space-3)">Even manageable migrations have one critical decision point.</h3>
          <p style="color:var(--color-text-secondary);margin-bottom:var(--space-4)">The main risk for programs at your complexity level is picking the wrong destination platform and discovering 6 months later that it doesn't fit. A 30-minute consultation will map your program to the right platform, flag any data worth saving from ${systemLabel}, and give you a clear migration sequence.</p>
          <a href="https://CALENDLY_PLACEHOLDER" class="btn btn-primary" rel="noopener">Book Free Consultation →</a>
        </div>
        ${q1 === 'RSA Archer' ? `<p style="margin-top:var(--space-4)"><a href="/archer-to-vanta-migration">Archer to Vanta Migration Guide →</a></p>` : ''}
        ${q1 === 'Spreadsheets' ? `<p style="margin-top:var(--space-4)"><a href="/how-to-choose-grc-platform">How to Choose a GRC Platform →</a></p>` : ''}
      `;
    }

    if (tier === 'SUBSTANTIAL') {
      const risks = [];
      if (knowledgeGap) risks.push('The person who built or maintained your system has left — institutional knowledge recovery is needed before migration can begin.');
      if (highCustom) risks.push('Your customization level means significant re-mapping work before any data can move.');
      if (shortTimeline) risks.push('Your audit or compliance deadline is close — the migration timeline needs careful sequencing.');

      return `
        <div style="margin-bottom:var(--space-6)">
          <span class="badge badge-amber" style="font-size:var(--text-base);padding:0.5rem 1.25rem">SUBSTANTIAL</span>
          <h2 style="font-size:var(--text-2xl);font-weight:800;margin:var(--space-4) 0 var(--space-3)">Your migration is doable — but it has real complexity drivers.</h2>
          <p style="color:var(--color-text-secondary);line-height:1.8">Based on your answers, migrating from ${systemLabel} has meaningful complexity that requires a structured approach. This isn't a weekend migration — it's a project with a scoping phase, a mapping phase, and a validation phase. Getting those phases right is the difference between a clean migration and one that creates compliance gaps.</p>
          ${risks.length > 0 ? `
          <div style="margin-top:var(--space-6)">
            <h3 style="font-weight:700;margin-bottom:var(--space-3)">Your key risk factors:</h3>
            <ul class="checklist">
              ${risks.map(r => `<li>${r}</li>`).join('')}
            </ul>
          </div>` : ''}
        </div>
        <div class="highlight-box">
          <h3 style="font-weight:700;margin-bottom:var(--space-3)">A scoping phase before platform commitment saves months.</h3>
          <p style="color:var(--color-text-secondary);margin-bottom:var(--space-4)">At this complexity level, committing to a platform before understanding what you have and what maps where often leads to scope surprises mid-migration. A consultation provides an independent scoping of your current system, a destination platform recommendation, and a phased migration plan with realistic timelines before you sign anything.</p>
          <a href="https://CALENDLY_PLACEHOLDER" class="btn btn-primary" rel="noopener">Book Free Consultation →</a>
        </div>
        ${q1 === 'RSA Archer' ? `<p style="margin-top:var(--space-4)"><a href="/archer-to-vanta-migration">Archer to Vanta Migration Guide →</a> · <a href="/rsa-archer-alternatives">Archer Alternatives Comparison →</a></p>` : ''}
      `;
    }

    // COMPLEX
    return `
      <div style="margin-bottom:var(--space-6)">
        <span class="badge badge-red" style="font-size:var(--text-base);padding:0.5rem 1.25rem">COMPLEX</span>
        <h2 style="font-size:var(--text-2xl);font-weight:800;margin:var(--space-4) 0 var(--space-3)">This is a significant migration project. Treat it like one.</h2>
        <p style="color:var(--color-text-secondary);line-height:1.8">Based on your answers, migrating from ${systemLabel} is a major undertaking. Migrations at this complexity profile fail when treated as a data-transfer task instead of a program redesign. The institutional knowledge, customization depth, and data volume you're dealing with all require deliberate scoping — not just execution.</p>
        <div style="margin-top:var(--space-6)">
          <h3 style="font-weight:700;margin-bottom:var(--space-3)">Your specific risk factors:</h3>
          <ul class="checklist">
            ${knowledgeGap ? '<li><strong>Critical:</strong> The institutional knowledge gap means you may not fully understand what you have. Discovery must come before mapping.</li>' : ''}
            ${highCustom ? '<li><strong>High effort:</strong> Your customization level means the control mapping exercise alone will take weeks of analysis time.</li>' : ''}
            ${shortTimeline ? '<li><strong>Timeline risk:</strong> Your audit is close. If the timeline is fixed, you may need to complete the audit on your current system first, then migrate.</li>' : ''}
            <li>At this complexity level, expect a 4–12 month migration depending on your specific profile and resource availability.</li>
          </ul>
        </div>
      </div>
      <div style="background:var(--color-primary);border-radius:var(--radius-lg);padding:var(--space-6);color:white;margin-bottom:var(--space-4)">
        <h3 style="font-weight:700;margin-bottom:var(--space-3);color:white">Before you talk to any platform vendor, get independent scoping.</h3>
        <p style="color:rgba(255,255,255,0.85);margin-bottom:var(--space-4)">At this profile, platform vendors will scope your migration optimistically — it's in their interest to close the deal. An independent scoping assessment gives you an honest picture of what you're starting from, what the migration actually involves, and what the right destination platform is before you commit budget and internal resources.</p>
        <a href="https://CALENDLY_PLACEHOLDER" class="btn btn-white" rel="noopener">Book Independent Scoping Consultation →</a>
      </div>
      ${q1 === 'RSA Archer' ? `<p style="margin-top:var(--space-4);color:var(--color-text-secondary)"><a href="/archer-to-vanta-migration">Archer to Vanta Migration Guide →</a> · <a href="/rsa-archer-alternatives">Archer Alternatives →</a></p>` : ''}
    `;
  }

  // Auto-advance on radio selection
  document.querySelectorAll('.radio-option input[type="radio"]').forEach(radio => {
    radio.addEventListener('change', () => {
      const qNum = parseInt(radio.closest('.question').dataset.question, 10);
      answers['q' + qNum] = radio.value;

      setTimeout(() => {
        if (qNum < totalQ) {
          showQuestion(qNum + 1);
        } else {
          showGate();
        }
      }, 350);
    });
  });

  function showGate() {
    document.getElementById('progress-label').textContent = 'Almost done!';
    document.getElementById('progress-pct').textContent = '100%';
    document.getElementById('progress-bar').style.width = '100%';
    document.getElementById('questions-wrapper').hidden = true;

    const score = getScore();
    const tier = getTier(score);

    const badge = document.getElementById('gate-score-badge');
    const tierLine = document.getElementById('gate-tier-line');

    const tierColors = { MANAGEABLE: '#10B981', SUBSTANTIAL: '#F59E0B', COMPLEX: '#EF4444' };
    badge.textContent = tier;
    badge.style.backgroundColor = tierColors[tier] + '20';
    badge.style.color = tierColors[tier];
    badge.style.border = '2px solid ' + tierColors[tier];
    tierLine.textContent = `Based on your answers, your migration complexity is ${tier}.`;

    const roleField = document.getElementById('role-field');
    if (roleField && answers.q8) roleField.value = answers.q8;

    document.getElementById('hidden-score').value = score;
    document.getElementById('hidden-tier').value = tier;
    document.getElementById('hidden-q1').value = answers.q1 || '';
    document.getElementById('hidden-q2').value = answers.q2 || '';
    document.getElementById('hidden-q3').value = answers.q3 || '';
    document.getElementById('hidden-q4').value = answers.q4 || '';
    document.getElementById('hidden-q5').value = answers.q5 || '';
    document.getElementById('hidden-q6').value = answers.q6 || '';
    document.getElementById('hidden-q7').value = answers.q7 || '';
    document.getElementById('hidden-q8').value = answers.q8 || '';

    document.getElementById('lead-gate').hidden = false;
  }

  document.getElementById('assessment-form').addEventListener('submit', function(e) {
    e.preventDefault();

    const score = parseInt(document.getElementById('hidden-score').value, 10);
    const tier = getTier(score);
    const q1 = document.getElementById('hidden-q1').value;
    const q3 = document.getElementById('hidden-q3').value;
    const q4 = document.getElementById('hidden-q4').value;
    const q6 = document.getElementById('hidden-q6').value;
    const role = document.getElementById('hidden-q8').value;

    const formData = new FormData(this);
    fetch('/', { method: 'POST', body: formData }).catch(() => {});

    document.getElementById('lead-gate').hidden = true;
    const resultsSection = document.getElementById('results-section');
    document.getElementById('results-content').innerHTML = buildResults(tier, q1, q3, q4, q6, role);
    resultsSection.hidden = false;
    resultsSection.scrollIntoView({ behavior: 'smooth' });
  });

  showQuestion(1);
})();
</script>
